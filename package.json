{
  "name": "galsenify",
  "version": "1.0.0",
  "description": "A comprehensive library for Senegalese data, it offers a lot of information about country of Teranga.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/cjs.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs": "typedoc --out docs src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daoodaba975/galsenify.git"
  },
  "keywords": [
    "senegal",
    "galsen",
    "data",
    "typescript",
    "regions",
    "departments",
    "africa"
  ],
  "author": "Daouda BA",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/daoodaba975/galsenify/issues"
  },
  "homepage": "https://github.com/daoodaba975/galsenify#readme",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.ts?(x)",
      "**/?(*.)+(spec|test).ts?(x)"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.75",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "jest": "^29.3.1",
    "prettier": "^3.4.2",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.0.5",
    "tsup": "^8.3.6",
    "typedoc": "^0.24.8",
    "typescript": "^4.9.5"
  }
}
